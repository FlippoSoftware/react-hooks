{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "root": true,
    "extends": ["@flippo-software/biome/base", "@flippo-software/biome/react"],
    "plugins": ["./node_modules/@flippo-software/biome/src/plugins/no-node-process-import/no-node-process-import.grit"],
    "files": {
        "includes": ["!**/temp"]
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "linter": {
        "rules": {
            "performance": {
                "noReExportAll": "off",
                "noBarrelFile": "off"
            }
        }
    }
}
